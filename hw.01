
x = 0
 

def A(a):
    print("$", end=(""))
    for n in range(a - 2, 0, -1):
        print("-", end=(""));
    print("$")

    for n in range(a-2, 0, -2):
        for n in range((x-n)/2):
            print(" ", end="")
        for n in range(n):
            print("x", end="");
        print("\n");

    for n in range(0, a-2, 2):           
            for n in range(n):
                print("x", end="");
            print("\n");
    
    print("$", end=(""))
    for n in range(a - 2, 0, -1):
        print("-", end=(""));
    print("$")

def B(b):
    print("nothing");

def C(c):
    print("nothing");


print("Zadejte cele liche cislo vetsi nebo rovno 3 a mensi nez30, pro nejsirsi radek obrazce.")

